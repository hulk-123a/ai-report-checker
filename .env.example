# 复制本文件为 .env.local 后填写真实值（.env.local 已被 .gitignore 忽略）
# 仅需一个 OpenAI 兼容的 Chat Completions 接口即可运行

# 模型接口密钥（只保存在服务端，绝不提交到仓库）
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# 接口地址：填到 /v1 或厂商文档给出的基地址，程序会自动补 /chat/completions
# DeepSeek:      https://api.deepseek.com/v1
# 智谱 GLM:      https://open.bigmodel.cn/api/paas/v4
# 通义千问:      https://dashscope.aliyuncs.com/compatible-mode/v1
# 月之暗面:      https://api.moonshot.cn/v1
LLM_BASE_URL=https://api.deepseek.com/v1

# 模型名
LLM_MODEL=deepseek-chat

# ===== 图像模态（可选增强，不配置不影响核心核查） =====
# 是否启用视觉 OCR：true / false。前端图片识别会调用服务端视觉通道。
LLM_VISION=false
# 视觉模型与其接口地址（可选）：留空则复用上面的 LLM_MODEL / LLM_BASE_URL
# 要求该模型兼容 OpenAI 的 image_url 多模态消息，例如：
#   智谱 GLM-4V:  LLM_VISION_MODEL=glm-4v-flash   LLM_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   通义千问 VL:  LLM_VISION_MODEL=qwen-vl-max    LLM_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_VISION_MODEL=
LLM_VISION_BASE_URL=

# 生产单进程服务端口（npm run serve 使用）
PORT=4173
